{
  "name": "f1-fantasy",
  "private": true,
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:rede": "vite --host",
    "sala": "node scripts/checar-porta-sala.ts && wrangler dev --port 8787 --var ENVIRONMENT:development",
    "build": "npm run typecheck && vite build && npm run checar:casca",
    "start:local": "npm run build && node scripts/checar-porta-sala.ts && wrangler dev --ip 127.0.0.1 --port 8787 --var ALLOWED_ORIGINS:http://127.0.0.1:8787,http://localhost:8787",
    "test": "vitest run",
    "test:party": "vitest run --config vitest.party.config.ts",
    "checar:casca": "node scripts/checar-casca-sem-node.ts",
    "test:watch": "vitest",
    "balance": "vitest run --config vitest.balance.config.ts --reporter=verbose --silent=false",
    "preview": "vitest run --config vitest.preview.config.ts --reporter=verbose --silent=false",
    "dataset:fetch": "node scripts/fetch-f1-data.ts",
    "dataset:fatos": "node scripts/agregar-fatos.ts",
    "dataset:notas": "node scripts/derivar-notas.ts",
    "dataset:publicar": "node scripts/publicar-dataset.ts",
    "dataset:report": "node scripts/dataset-report.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p party/tsconfig.json && tsc --noEmit -p party/tsconfig.test.json"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260809.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.0.0",
    "partyserver": "^0.5.10",
    "prettier": "^3.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0",
    "wrangler": "4.120.0"
  }
}
