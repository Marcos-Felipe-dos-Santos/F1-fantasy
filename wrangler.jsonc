{
  // Fase 3 — sala online como Durable Object (PR 3.2).
  //
  // Par de versões validado no SPIKE 3.0 e fixado aqui de propósito:
  // partyserver@0.5.10 + wrangler@4.120.0 + @cloudflare/workers-types, Node
  // v24.16.0. Os dois primeiros são pré-1.0/móveis — se algo quebrar, suspeitar
  // da versão antes do código.
  //
  // ⚠️ `compatibility_flags: ["nodejs_compat"]` NÃO está aqui, e isso é decisão,
  // não esquecimento. O spike a tinha, posta defensivamente, e o registro do
  // próprio spike diz que ela não sustentava nada. Medido neste PR: o worker
  // sobe, serve e passa o smoke SEM ela — o grafo de imports do DO
  // (`src/net/*` + `src/engine/rng` + `src/engine/draft-utils`) não toca módulo
  // `node:*` nenhum. Se um dia precisar voltar, registrar QUAL import exigiu.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "f1-fantasy-sala",
  "main": "party/sala.ts",
  "compatibility_date": "2026-08-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "Sala",
        "class_name": "Sala"
      },
      // O balde do teto de `POST /criar-sala` (PR H1). Um DO por IP, via
      // `idFromName(ip)` — o IP é o shard, então não há gargalo global.
      {
        "name": "Limite",
        "class_name": "Limite"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Sala"]
    },
    // 🔒 Classe de DO nova exige tag NOVA. Sem isto o `wrangler deploy` falha —
    // e falha no DEPLOY, não no teste, que é o pior lugar para descobrir.
    // `new_sqlite_classes` mesmo o balde vivendo só em memória: a migração
    // declara a classe, não o uso que ela faz do storage.
    {
      "tag": "v2",
      "new_sqlite_classes": ["Limite"]
    }
  ],
  // 🔒 OS DOIS VALORES ABAIXO SÃO O PADRÃO SEGURO, E O PADRÃO SEGURO É RECUSAR.
  // Com `ALLOWED_ORIGINS` vazio e `ENVIRONMENT` diferente de "development", o
  // `POST /criar-sala` não libera origem nenhuma. É o comportamento certo para
  // um deploy que esqueceu de configurar — que é a falha mais provável, porque
  // é a de omissão. Ver `src/net/cors.ts`.
  //
  // 🔴 **`ENVIRONMENT` NÃO pode ser "development" aqui.** Este mesmo arquivo é
  // o que o `wrangler deploy` consome: pôr o sinal de dev na config commitada
  // o levaria para produção e ANULARIA o PR inteiro, em silêncio. O sinal de
  // dev entra pela linha de comando, no `npm run sala` — ver o `package.json`.
  //
  // O domínio de produção e as origens de túnel/LAN entram em
  // `ALLOWED_ORIGINS` (aqui ou por `--var`) quando o deploy existir.
  "vars": {
    "ALLOWED_ORIGINS": "",
    "ENVIRONMENT": "production"
  }
}
